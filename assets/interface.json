    "interface_version": 2,
    "name": "Maa-gjxxl",
    "description": "挂机修仙录自动化任务脚本。",
    "contact": "",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/MaaXYZ/MaaPracticeBoilerplate",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Legend|挂机放置修仙录",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "刷卷轴材料",
            "entry": "检测红点"
        },
        {
            "name": "自动卖装备",
            "entry": "自动卖装备",
            "option": [
                "卖装备位置"
            ]
        }
    ],
    "option": {
        "卖装备位置": {
            "type": "select",
            "cases": [
                {
                    "name": "1",
                    "label": "第一行",
                    "pipeline_override": {
                        "自动卖装备": {
                            "next": [
                                "点击第一行"
                            ]
                        }
                    }
                },
                {
                    "name": "2",
                    "label": "第二行",
                    "pipeline_override": {
                        "自动卖装备": {
                            "next": [
                                "点击第二行"
                            ]
                        }
                    }
                },
                {
                    "name": "3",
                    "label": "第三行",
                    "pipeline_override": {
                        "自动卖装备": {
                            "next": [
                                "点击第三行"
                            ]
                        }
                    }
                },
                {
                    "name": "4",
                    "label": "第四行",
                    "pipeline_override": {
                        "自动卖装备": {
                            "next": [
                                "点击第四行"
                            ]
                        }
                    }
                },
                {
                    "name": "5",
                    "label": "第五行",
                    "pipeline_override": {
                        "自动卖装备": {
                            "next": [
                                "点击第五行"
                            ]
                        }
                    }
                }
            ],
            "label": "自动出售位置",
            "description": "1-5对应背包1-5行第1列的格子，格子中装备会自动卖出，需要先进行装备排序，不需要的装备在最后，自动卖出所选位置以及后方所有装备"
        }
    },
    "label": "挂机修仙录-自动化工具",
    "title": "挂机修仙录-自动化工具"
}